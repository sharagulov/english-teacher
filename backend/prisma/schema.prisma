



generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  
}



model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  
  points Int @default(50)
  level  Int @default(1)

  
  dailyStreak     Int     @default(0)
  longestStreak   Int     @default(0)
  lastActiveDay   String? 
  streakFreezes   Int     @default(1)
  dailyGoalWords  Int     @default(20)
  lastRewardedDay String? 

  
  cefrLevel      String  @default("A2") 
  typoTolerance  Boolean @default(true) 
  soundEnabled   Boolean @default(true)
  autoAdvance    Boolean @default(true)
  showTranscript Boolean @default(true)
  timezoneOffset Int     @default(180) 

  
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)
  aiCostUsd      Float @default(0)
  aiRequests     Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words         UserWord[]
  pools         Pool[]
  attempts      Attempt[]
  transactions  Transaction[]
  achievements  UserAchievement[]
  dailyStats    DailyStat[]
  aiTasks       AiTask[]
  aiSubmissions AiSubmission[]
  chatSessions  ChatSession[]
  ownedWords    Word[]            @relation("WordOwner")

  @@index([email])
}



model Word {
  id            Int     @id @default(autoincrement())
  text          String 
  translations  String 
  partOfSpeech  String? 
  level         String  @default("A2") 
  topic         String? 
  transcription String? 
  audioUrl      String? 
  gloss         String? 
  senses        String? 
  example       String? 
  exampleRu     String? 
  frequencyRank Int? 

  
  source         String    @default("wikdict") 
  license        String? 
  pack           String? 
  isFunctionWord Boolean   @default(false) 
  enrichedAt     DateTime? 
  examplesAt     DateTime? 

  
  ownerId String?
  owner   User?   @relation("WordOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userWords UserWord[]
  poolItems PoolItem[]
  attempts  Attempt[]
  examples  WordExample[]

  @@unique([text, ownerId])
  @@index([level])
  @@index([topic])
  @@index([frequencyRank])
  @@index([ownerId])
  @@index([pack])
  @@index([isFunctionWord, level])
  @@index([examplesAt])
}



model WordExample {
  id     Int  @id @default(autoincrement())
  wordId Int
  word   Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  text        String 
  translation String? 
  source      String  @default("tatoeba") 
  sourceRef   String? 
  position    Int     @default(0) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  @@unique([wordId, text])
  @@index([wordId, position])
}



model UserWord {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId Int
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  
  timesSeen     Int @default(0)
  timesCorrect  Int @default(0)
  timesWrong    Int @default(0)
  currentStreak Int @default(0)
  bestStreak    Int @default(0)
  hintsUsed     Int @default(0)

  
  strength     Float @default(0) 
  ease         Float @default(2.5) 
  intervalDays Float @default(0)
  repetitions  Int   @default(0)
  lapses       Int   @default(0) 

  status String @default("new") 

  avgResponseMs  Int       @default(0)
  lastResult     Boolean?
  lastSeenAt     DateTime?
  firstSeenAt    DateTime?
  learnedAt      DateTime? 
  masteredAt     DateTime?
  dueAt          DateTime  @default(now())
  isFavorite     Boolean   @default(false)
  isIgnored      Boolean   @default(false)
  
  dislikeLevel   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([userId, timesWrong])
  @@index([userId, strength])
}



model Pool {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  size      Int 
  mode      String 
  status    String  @default("active") 
  filters   String? 
  ordinal   Int     @default(1) 

  correctCount Int @default(0)
  wrongCount   Int @default(0)
  pointsEarned Int @default(0)
  durationMs   Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  items    PoolItem[]
  attempts Attempt[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model PoolItem {
  id     Int    @id @default(autoincrement())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  wordId Int
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  position     Int     @default(0)
  solved       Boolean @default(false)
  attempts     Int     @default(0)
  wrongCount   Int     @default(0)
  lastShownAt  DateTime?
  solvedAt     DateTime?

  
  choicesJson String?
  
  hintHidden  String?

  @@unique([poolId, wordId])
  @@index([poolId, solved])
}

model Attempt {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId Int
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  poolId String?
  pool   Pool?  @relation(fields: [poolId], references: [id], onDelete: SetNull)

  mode      String 
  direction String 
  question  String
  expected  String
  given     String
  isCorrect Boolean
  matchType String 
  responseMs Int    @default(0)
  hintsUsed  Int    @default(0)
  points     Int    @default(0)

  
  undoSnapshot String?
  undoneAt     DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, wordId])
  @@index([poolId])
}





model Transaction {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount       Int
  reason       String 
  meta         String? 
  balanceAfter Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason])
}

model UserAchievement {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code       String 
  progress   Int      @default(0)
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}



model DailyStat {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  day String 

  attempts   Int @default(0)
  correct    Int @default(0)
  wrong      Int @default(0)
  newWords   Int @default(0)
  learned    Int @default(0) 
  mastered   Int @default(0)
  points     Int @default(0)
  timeMs     Int @default(0)
  aiTasks        Int   @default(0)
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)
  aiCostUsd      Float @default(0)
  poolsDone      Int   @default(0)

  @@unique([userId, day])
  @@index([userId, day])
}



model AiTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  
  type    String
  level   String
  topic   String?
  payload String 
  usedWordIds String? 

  createdAt DateTime @default(now())

  submissions AiSubmission[]

  @@index([userId, createdAt])
  @@index([userId, type])
}

model AiSubmission {
  id     Int    @id @default(autoincrement())
  taskId String
  task   AiTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answer    String
  score     Int 
  isCorrect Boolean
  feedback  String 
  points    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  scenario String 
  level    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role       String 
  content    String
  correction String? 

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}
