// Lexio — схема данных.
// SQLite: перечисления и массивы не поддерживаются, поэтому используются String
// и JSON-строки (в комментариях указан ожидаемый набор значений).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // URL задаётся в prisma.config.ts через переменную DATABASE_URL
}

// ─────────────────────────────── Пользователь ───────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  // Прогресс: очки рейтинга задают уровень (1..1000). Тратятся на подсказку в «Выборе».
  points Int @default(50)
  level  Int @default(1)

  // Ежедневная серия
  dailyStreak     Int     @default(0)
  longestStreak   Int     @default(0)
  lastActiveDay   String? // YYYY-MM-DD в часовом поясе пользователя
  streakFreezes   Int     @default(1)
  dailyGoalWords  Int     @default(20)
  lastRewardedDay String? // день, за который уже начислен бонус серии

  // Настройки
  cefrLevel      String  @default("A2") // A1 | A2 | B1 | B2 | C1 | C2
  typoTolerance  Boolean @default(true) // прощать 1 опечатку
  soundEnabled   Boolean @default(true)
  autoAdvance    Boolean @default(true)
  showTranscript Boolean @default(true)
  timezoneOffset Int     @default(180) // минуты от UTC, для корректных «дней»

  // Суммарный расход на OpenAI (оценка по тарифам модели)
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)
  aiCostUsd      Float @default(0)
  aiRequests     Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words         UserWord[]
  pools         Pool[]
  attempts      Attempt[]
  transactions  Transaction[]
  achievements  UserAchievement[]
  dailyStats    DailyStat[]
  aiTasks       AiTask[]
  aiSubmissions AiSubmission[]
  chatSessions  ChatSession[]
  ownedWords    Word[]            @relation("WordOwner")

  @@index([email])
}

// ──────────────────────────────── Словарь ────────────────────────────────

model Word {
  id            Int     @id @default(autoincrement())
  text          String // английское слово/выражение в нижнем регистре
  translations  String // JSON-массив русских переводов, первый — основной
  partOfSpeech  String? // noun | verb | adjective | adverb | phrase | ...
  level         String  @default("A2") // A1..C2
  topic         String? // тематическая группа
  transcription String? // /ˈeksəmpl/
  audioUrl      String? // ссылка на озвучку, если нашлась в открытом источнике
  gloss         String? // краткое пояснение смысла на английском
  senses        String? // JSON: [{ sense, translations[] }] — значения по отдельности
  example       String? // пример употребления на английском
  exampleRu     String? // перевод примера
  frequencyRank Int? // чем меньше, тем частотнее слово

  // Служебное
  source         String    @default("wikdict") // wikdict | ai | user
  license        String? // лицензия исходных данных (для атрибуции)
  pack           String? // название набора, если слово пришло из пака
  isFunctionWord Boolean   @default(false) // артикли, предлоги и пр. — не для перевода
  enrichedAt     DateTime? // когда подтянуты транскрипция/пример
  examplesAt     DateTime? // когда слово прогонялось по корпусу примеров (даже если ничего не нашлось)

  // Приватные слова пользователя (общие слова словаря — ownerId = null)
  ownerId String?
  owner   User?   @relation("WordOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userWords UserWord[]
  poolItems PoolItem[]
  attempts  Attempt[]
  examples  WordExample[]

  @@unique([text, ownerId])
  @@index([level])
  @@index([topic])
  @@index([frequencyRank])
  @@index([ownerId])
  @@index([pack])
  @@index([isFunctionWord, level])
  @@index([examplesAt])
}

// ──────────────────────── Примеры употребления слова ────────────────────────

model WordExample {
  id     Int  @id @default(autoincrement())
  wordId Int
  word   Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  text        String // короткая фраза на английском с этим словом
  translation String? // перевод на русский, если он есть в источнике
  source      String  @default("tatoeba") // tatoeba | dictionary | ai
  sourceRef   String? // ссылка на исходную фразу — для атрибуции
  position    Int     @default(0) // порядок показа: сначала самые удачные

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Один и тот же текст у слова не дублируем: примеры доливаются из разных источников.
  @@unique([wordId, text])
  @@index([wordId, position])
}

// ─────────────────────── Прогресс пользователя по слову ───────────────────────

model UserWord {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId Int
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  // Счётчики
  timesSeen     Int @default(0)
  timesCorrect  Int @default(0)
  timesWrong    Int @default(0)
  currentStreak Int @default(0)
  bestStreak    Int @default(0)
  hintsUsed     Int @default(0)

  // Модель памяти (SM-2 с доработками)
  strength     Float @default(0) // 0..1 — насколько надёжно слово выучено
  ease         Float @default(2.5) // фактор легкости
  intervalDays Float @default(0)
  repetitions  Int   @default(0)
  lapses       Int   @default(0) // сколько раз забывал после успеха

  status String @default("new") // new | learning | review | mastered | leech

  avgResponseMs  Int       @default(0)
  lastResult     Boolean?
  lastSeenAt     DateTime?
  firstSeenAt    DateTime?
  learnedAt      DateTime? // когда впервые перешло в review
  masteredAt     DateTime?
  dueAt          DateTime  @default(now())
  isFavorite     Boolean   @default(false)
  isIgnored      Boolean   @default(false)
  // 0 — обычная выдача, 1 — реже в пуллах, 2 — почти не показывать
  dislikeLevel   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([userId, timesWrong])
  @@index([userId, strength])
}

// ──────────────────────────── Пуллы и попытки ────────────────────────────

model Pool {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  size      Int // 10 | 20 | 30 | ...
  mode      String // classic | reverse | choice | listening | sprint | weak | srs | mixed
  status    String  @default("active") // active | completed | abandoned
  filters   String? // JSON: { levels, topics, onlyDue, ... }
  ordinal   Int     @default(1) // номер пулла подряд для этого пользователя

  correctCount Int @default(0)
  wrongCount   Int @default(0)
  pointsEarned Int @default(0)
  durationMs   Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  items    PoolItem[]
  attempts Attempt[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model PoolItem {
  id     Int    @id @default(autoincrement())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  wordId Int
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  position     Int     @default(0)
  solved       Boolean @default(false)
  attempts     Int     @default(0)
  wrongCount   Int     @default(0)
  lastShownAt  DateTime?
  solvedAt     DateTime?

  /** Зафиксированные варианты в режиме выбора (JSON-массив из 4 строк). */
  choicesJson String?
  /** Два скрытых неверных варианта после платной подсказки (JSON-массив). */
  hintHidden  String?

  @@unique([poolId, wordId])
  @@index([poolId, solved])
}

model Attempt {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId Int
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  poolId String?
  pool   Pool?  @relation(fields: [poolId], references: [id], onDelete: SetNull)

  mode      String // classic | reverse | choice | listening | sprint | weak | srs
  direction String // en_ru | ru_en | audio_en
  question  String
  expected  String
  given     String
  isCorrect Boolean
  matchType String // exact | alternative | typo | wrong | skipped
  responseMs Int    @default(0)
  hintsUsed  Int    @default(0)
  points     Int    @default(0)

  /** Снимок состояния до ответа — для отмены неверного ответа. */
  undoSnapshot String?
  undoneAt     DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, wordId])
  @@index([poolId])
}

// ───────────────────────────── Рейтинг ─────────────────────────────

// История начислений очков: рейтинг только растёт, поэтому amount всегда > 0,
// а balanceAfter — это рейтинг после начисления.
model Transaction {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount       Int
  reason       String // correct_answer | pool_complete | daily_streak | achievement:... | ai:... | ...
  meta         String? // JSON с деталями
  balanceAfter Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason])
}

model UserAchievement {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code       String // определение достижения хранится в коде
  progress   Int      @default(0)
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

// ──────────────────────── Ежедневная агрегация ────────────────────────

model DailyStat {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  day String // YYYY-MM-DD

  attempts   Int @default(0)
  correct    Int @default(0)
  wrong      Int @default(0)
  newWords   Int @default(0)
  learned    Int @default(0) // перешло в review
  mastered   Int @default(0)
  points     Int @default(0)
  timeMs     Int @default(0)
  aiTasks        Int   @default(0)
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)
  aiCostUsd      Float @default(0)
  poolsDone      Int   @default(0)

  @@unique([userId, day])
  @@index([userId, day])
}

// ────────────────────────────── ИИ-задания ──────────────────────────────

model AiTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // sentence_ru_en | sentence_en_ru | grammar_quiz | cloze | writing | listening | word_deep_dive
  type    String
  level   String
  topic   String?
  payload String // JSON с содержимым задания
  usedWordIds String? // JSON-массив id слов, задействованных в задании

  createdAt DateTime @default(now())

  submissions AiSubmission[]

  @@index([userId, createdAt])
  @@index([userId, type])
}

model AiSubmission {
  id     Int    @id @default(autoincrement())
  taskId String
  task   AiTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answer    String
  score     Int // 0..100
  isCorrect Boolean
  feedback  String // JSON: { verdict, errors[], better, explanation }
  points    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  scenario String // free | cafe | airport | interview | doctor | smalltalk | custom
  level    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role       String // user | assistant
  content    String
  correction String? // JSON с разбором ошибок в реплике пользователя

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}
