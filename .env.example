# ─── Скопируйте этот файл в backend/.env и заполните значения ───

# База данных (SQLite, путь относительно папки backend)
DATABASE_URL="file:./prisma/dev.db"

# Порт и адрес API
PORT=4000
HOST=0.0.0.0

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО поменяйте на длинную случайную строку.
JWT_SECRET="change-me-to-a-long-random-string"

# Разрешённые источники для CORS (через запятую)
CORS_ORIGIN="http://localhost:5173"

# ─── OpenAI ───
# Ключ из https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Модель для генерации заданий и проверки ответов
OPENAI_MODEL="gpt-4o-mini"
# Опционально: свой базовый URL (прокси, Azure, OpenRouter и т.п.)
# OPENAI_BASE_URL="https://api.openai.com/v1"
